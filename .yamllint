# yamllint 配置：CI 中对所有 YAML 做规范检查
extends: default

# Helm 模板是 Go template，渲染前不是合法 YAML，由 helm lint 单独校验
ignore: |
  helm/taskflow/templates/

rules:
  line-length:
    max: 120
    level: warning
  # kustomize edit 回写的 kustomization.yaml 顶格列表与手工缩进风格并存，只要求文件内一致
  indentation:
    indent-sequences: consistent
  document-start: disable
  truthy: disable
  comments-indentation: disable
