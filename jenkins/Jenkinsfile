// Jenkins 声明式流水线（与 GitHub Actions 等价的备选方案，便于对接已有 Jenkins 的团队）
// 使用前准备：Jenkins 安装 Docker/Pipeline 插件；将 registry 凭据存为 'registry-credentials'；
// kubeconfig 存为 file 凭据 'kubeconfig'。
pipeline {
    agent any

    environment {
        TAG = "build-${env.BUILD_NUMBER}"
        IMAGE_API = "registry.example.com/taskflow-api"
        IMAGE_WEB = "registry.example.com/taskflow-web"
    }

    stages {
        stage('Lint') {
            steps {
                sh 'hadolint app/api/Dockerfile app/web/Dockerfile'
            }
        }
        stage('Test') {
            steps {
                dir('app/api') {
                    sh 'sh ./mvnw -B verify'   // 含 JaCoCo 覆盖率门禁
                }
            }
        }
        stage('Build') {
            steps {
                sh 'docker build -t $IMAGE_API:$TAG app/api'
                sh 'docker build -t $IMAGE_WEB:$TAG app/web'
            }
        }
        stage('Scan') {
            steps {
                sh 'trivy image --severity CRITICAL,HIGH --ignore-unfixed --exit-code 1 $IMAGE_API:$TAG'
                sh 'trivy image --severity CRITICAL,HIGH --ignore-unfixed --exit-code 1 $IMAGE_WEB:$TAG'
            }
        }
        stage('Push') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'registry-credentials',
                                                  usernameVariable: 'REG_USER',
                                                  passwordVariable: 'REG_PASS')]) {
                    sh 'echo "$REG_PASS" | docker login registry.example.com -u "$REG_USER" --password-stdin'
                    sh 'docker push $IMAGE_API:$TAG && docker push $IMAGE_WEB:$TAG'
                }
            }
        }
        stage('Deploy') {
            steps {
                withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                    sh 'kubectl apply -k k8s/overlays/prod'
                    sh 'kubectl rollout status deployment/api -n taskflow --timeout=180s'
                }
            }
        }
    }

    post {
        failure { echo '流水线失败，请检查上方日志' }
        success { echo "发布成功：${env.IMAGE_API}:${env.TAG}" }
    }
}
